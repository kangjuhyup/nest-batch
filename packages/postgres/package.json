{
  "name": "@nest-batch/postgres",
  "version": "0.0.1",
  "description": "Postgres persistence adapter for nest-batch.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:e2e": "vitest run --root ../.. --config vitest.e2e.config.ts packages/postgres/test/postgres.e2e.test.ts",
    "test:perf": "vitest run --root ../.. --config vitest.perf.config.ts packages/postgres/test/postgres.perf.test.ts",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/postgres/test/adapter.test.ts packages/postgres/test/storage.test.ts"
  },
  "dependencies": {
    "@nest-batch/core": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
