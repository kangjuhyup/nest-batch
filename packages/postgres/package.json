{
  "name": "@nest-batch/postgres",
  "version": "0.1.0",
  "description": "Postgres persistence adapter for nest-batch.",
  "keywords": ["nestjs", "batch", "postgres", "persistence"],
  "type": "module",
  "license": "MIT",
  "author": "kangjuhyup",
  "repository": {
    "type": "git",
    "url": "https://github.com/kangjuhyup/nest-batch.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://github.com/kangjuhyup/nest-batch#readme",
  "bugs": {
    "url": "https://github.com/kangjuhyup/nest-batch/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:e2e": "vitest run --root ../.. --config vitest.e2e.config.ts packages/postgres/test/postgres.e2e.test.ts",
    "test:perf": "vitest run --root ../.. --config vitest.perf.config.ts packages/postgres/test/postgres.perf.test.ts",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/postgres/test"
  },
  "dependencies": {
    "@nest-batch/core": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
