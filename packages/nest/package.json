{
  "name": "@rvkang/batch-nest",
  "version": "0.1.0",
  "description": "NestJS integration for nest-batch.",
  "keywords": ["nestjs", "batch", "integration", "decorator"],
  "type": "module",
  "license": "MIT",
  "author": "kangjuhyup",
  "repository": {
    "type": "git",
    "url": "https://github.com/kangjuhyup/nest-batch.git",
    "directory": "packages/nest"
  },
  "homepage": "https://github.com/kangjuhyup/nest-batch#readme",
  "bugs": {
    "url": "https://github.com/kangjuhyup/nest-batch/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
