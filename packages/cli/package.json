{
  "name": "@nest-batch/cli",
  "version": "0.0.1",
  "description": "Operational CLI boundary for nest-batch.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nest-batch": "./dist/bin.js"
  },
  "exports": {
    ".": {
