  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/cli/test/run-cli.test.ts"
  },
  "dependencies": {
    "@nest-batch/core": "workspace:*"
  }
}
