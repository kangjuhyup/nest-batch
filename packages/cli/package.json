{
  "name": "@rvkang/batch-cli",
  "version": "0.1.0",
  "description": "Operational CLI for running and inspecting nest-batch jobs.",
  "keywords": ["nestjs", "batch", "cli", "operations"],
  "type": "module",
  "license": "MIT",
  "author": "kangjuhyup",
  "repository": {
    "type": "git",
    "url": "https://github.com/kangjuhyup/nest-batch.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kangjuhyup/nest-batch#readme",
  "bugs": {
    "url": "https://github.com/kangjuhyup/nest-batch/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nest-batch": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/cli/test/run-cli.test.ts"
  },
  "dependencies": {
    "@rvkang/batch-core": "workspace:*"
  }
}
