{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nest-batch/core/queue": ["packages/core/src/queue/index.ts"],
      "@nest-batch/core": ["packages/core/src/index.ts"],
      "@nest-batch/nest": ["packages/nest/src/index.ts"],
      "@nest-batch/inmemory": ["packages/inmemory/src/index.ts"],
      "@nest-batch/postgres": ["packages/postgres/src/index.ts"],
      "@nest-batch/mysql": ["packages/mysql/src/index.ts"],
      "@nest-batch/mariadb": ["packages/mariadb/src/index.ts"],
      "@nest-batch/polling-core": ["packages/polling-core/src/index.ts"],
      "@nest-batch/scheduler-core": ["packages/scheduler-core/src/index.ts"],
      "@nest-batch/scheduler-calendar": ["packages/scheduler-calendar/src/index.ts"],
      "@nest-batch/queue-core": ["packages/queue-core/src/index.ts"],
      "@nest-batch/queue-bullmq": ["packages/queue-bullmq/src/index.ts"],
      "@nest-batch/worker-local": ["packages/worker-local/src/index.ts"],
      "@nest-batch/worker-threads": ["packages/worker-threads/src/index.ts"],
      "@nest-batch/cli": ["packages/cli/src/index.ts"]
    }
  }
}
