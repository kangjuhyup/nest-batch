{
  "name": "nest-batch",
  "version": "0.1.0",
  "description": "Node-native durable batch framework packages for NestJS applications.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "license": "MIT",
  "author": "kangjuhyup",
  "repository": {
    "type": "git",
    "url": "https://github.com/kangjuhyup/nest-batch.git"
  },
  "homepage": "https://github.com/kangjuhyup/nest-batch#readme",
  "bugs": {
    "url": "https://github.com/kangjuhyup/nest-batch/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:adapters": "vitest run --config vitest.e2e.config.ts ./packages/",
    "test:e2e:example-basic": "vitest run --config vitest.e2e.config.ts examples/basic/test/basic-example.e2e.test.ts",
    "test:e2e:example-nestjs": "vitest run --config vitest.e2e.config.ts examples/nestjs/test/nestjs-example.e2e.test.ts",
    "test:e2e:examples": "vitest run --config vitest.e2e.config.ts ./examples/",
    "test:e2e:postgres": "vitest run --config vitest.e2e.config.ts packages/postgres/test/postgres.e2e.test.ts",
    "test:e2e:redis": "vitest run --config vitest.e2e.config.ts packages/bullmq/test/bullmq-work-queue.e2e.test.ts",
    "test:e2e:system": "vitest run --config vitest.e2e.config.ts ./e2e/",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:perf:postgres": "vitest run --config vitest.perf.config.ts packages/postgres/test/postgres.perf.test.ts",
    "typecheck": "tsc -b",
    "changeset": "changeset",
    "release:version": "node scripts/release/version-packages.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:smoke": "node scripts/release/smoke-packages.mjs",
    "release:check": "node scripts/release/release-check.mjs",
    "release:publish": "node scripts/release/publish-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
