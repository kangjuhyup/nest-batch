{
  "name": "nest-batch",
  "version": "0.0.1",
  "description": "Node-native batch framework packages for NestJS applications.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:postgres": "vitest run --config vitest.e2e.config.ts packages/postgres/test/postgres.e2e.test.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:perf:postgres": "vitest run --config vitest.perf.config.ts packages/postgres/test/postgres.perf.test.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
